APP_NAME=CareerCraft AI
DEBUG=True
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/careercraft_ai

# JWT Authentication settings
SECRET_KEY=replace-this-with-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Fernet key for encrypting OAuth tokens (if blank, derived from SECRET_KEY)
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 (Phase 2 - Google Drive Integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# GitHub OAuth App (Phase 2 - GitHub Integration)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Optional custom path for ChromaDB persistence (defaults to storage/chroma)
CHROMA_PERSIST_DIR=

